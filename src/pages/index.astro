---
import MainLayout from '../layouts/MainLayout.astro';
import TechStack from '../components/TechStack';
import FeaturedProjects from '../components/FeaturedProjects';
import Hero from '../components/Hero';
import CallToAction from '../components/CallToAction';
import Certifications from '../components/Certifications';
---

<MainLayout
  title="Mohammed Abaan | AI, ML, and Full-Stack Developer"
  description="Portfolio of Mohammed Abaan featuring AI/ML systems, full-stack projects, technical experience, and contact details."
  canonicalPath="/"
>
  <div class="pt-16 md:pt-24"></div>
  <Hero client:load />

  <TechStack client:load limit={6} showViewMoreButton={true} />
  <section class="px-2 sm:px-4 md:px-6 lg:px-8 mt-12">
    <div class="max-w-6xl mx-auto">
      <Certifications client:load />
    </div>
  </section>
  <FeaturedProjects client:load />

  <CallToAction client:load />
</MainLayout>
