---
import MainLayout from '../layouts/MainLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline';
---

<MainLayout>
  <div class="pt-16 md:pt-24"></div>
  
  {/* Experience Page Header */}
  <section class="px-4 sm:px-6 md:px-8 mb-16">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4">
        Professional Journey
      </h1>
      <p class="text-lg md:text-xl text-text-secondary leading-relaxed max-w-3xl mx-auto">
        Explore my professional experience, research contributions, and leadership roles that have shaped my journey in technology and innovation.
      </p>
    </div>
  </section>

  {/* Experience Timeline */}
  <section class="px-4 sm:px-6 md:px-8 mb-16">
    <div class="max-w-6xl mx-auto">
      <ExperienceTimeline client:load />
    </div>
  </section>

  {/* Skills Summary Section */}
  <section class="px-4 sm:px-6 md:px-8 mb-16">
    <div class="max-w-5xl mx-auto">
      <div class="bg-surface border border-muted rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-6 text-center">
          Core Competencies
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {/* Technical Skills */}
          <div class="space-y-3">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd" /></svg>
              <h3 class="text-lg font-bold text-text-primary">Technical Skills</h3>
            </div>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Machine Learning & Deep Learning</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Full-Stack Web Development</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Data Science & Analysis</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Cloud Architecture & Serverless</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>AI Systems & NLP</span>
              </li>
            </ul>
          </div>

          {/* Tools & Technologies */}
          <div class="space-y-3">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
              <h3 class="text-lg font-bold text-text-primary">Tools & Technologies</h3>
            </div>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Python, SQL, JavaScript, .NET</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>PyTorch, TensorFlow, FAISS</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>React, Astro, Three.js, jQuery</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>AWS Amplify, Lambda, SharePoint</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Transformers, CNNs, LSTMs</span>
              </li>
            </ul>
          </div>

          {/* Soft Skills */}
          <div class="space-y-3">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <h3 class="text-lg font-bold text-text-primary">Professional Skills</h3>
            </div>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Research & Development</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Teaching & Mentorship</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Data Analysis & Visualization</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>QA Testing & Documentation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">▸</span>
                <span>Cross-functional Collaboration</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Contact CTA */}
  <section class="px-4 sm:px-6 md:px-8 mb-16">
    <div class="max-w-3xl mx-auto">
      <div class="bg-gradient-to-br from-surface to-muted/20 border-2 border-accent rounded-2xl p-8 text-center shadow-lg">
        <h3 class="text-2xl font-bold text-text-primary mb-3">
          Let's Build Something Together
        </h3>
        <p class="text-text-secondary mb-6 text-base leading-relaxed">
          I'm always open to discussing new opportunities, collaborations, or innovative projects. Whether you have a role in mind or just want to connect, I'd love to hear from you!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn text-base font-semibold px-7 py-3" style="display: inline-flex; align-items: center; justify-content: center;">
            Get in Touch
          </a>
          <a
            href="/projects"
            class="px-7 py-3 rounded-md font-semibold text-base transition-all border-2 border-accent text-accent hover:bg-accent hover:text-white"
            style="display: inline-flex; align-items: center; justify-content: center;"
          >
            View My Work
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section {
    animation: fadeInUp 0.6s ease-out;
  }
</style>
