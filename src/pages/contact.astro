---
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/ContactForm";

const contactEmail = "me@mabaan.com";
---

<MainLayout>
  <div class="pt-16 md:pt-24"></div>

  <section class="px-4 sm:px-6 md:px-8 mb-12">
    <div class="max-w-5xl mx-auto relative overflow-hidden rounded-3xl border border-muted bg-surface p-8 md:p-10 shadow-sm">
      <div
        class="pointer-events-none absolute -top-20 -right-16 h-64 w-64 rounded-full blur-3xl opacity-20"
        style="background: var(--color-accent);"
      ></div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-16 h-64 w-64 rounded-full blur-3xl opacity-20"
        style="background: var(--muted);"
      ></div>

      <div class="relative text-center">
        <p class="text-sm font-semibold tracking-[0.25em] uppercase text-text-secondary mb-3">Contact</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight">
          Let us build something useful together.
        </h1>
        <p class="mt-4 text-base md:text-lg text-text-secondary max-w-3xl mx-auto leading-relaxed">
          Have an idea or opportunity in mind? I'd love to hear about it and explore how we can work together.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-6 md:px-8 mb-16">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-6">
      <div class="lg:col-span-2 space-y-5">
        <div class="rounded-3xl border border-muted bg-surface p-6 shadow-sm">
          <h2 class="text-xl font-bold text-text-primary mb-4">Direct Channels</h2>
          <div class="space-y-3 text-text-secondary">
            <a
              href={`mailto:${contactEmail}`}
              class="flex items-start gap-3 p-3 rounded-xl border border-muted hover:border-accent hover:text-accent transition no-underline"
            >
              <span class="mt-0.5 text-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M2.94 6.34A2 2 0 014.88 5h10.24a2 2 0 011.94 1.34L10 10.6 2.94 6.34z"/><path d="M18 8.4l-7.53 4.02a1 1 0 01-.94 0L2 8.4V14a2 2 0 002 2h12a2 2 0 002-2V8.4z"/></svg>
              </span>
              <span>
                <span class="block font-semibold text-text-primary">Email</span>
                <span class="text-sm">{contactEmail}</span>
              </span>
            </a>

            <a
              href="https://linkedin.com/in/mohammed-abaan-0245ba289"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3 p-3 rounded-xl border border-muted hover:border-accent hover:text-accent transition no-underline"
            >
              <span class="mt-0.5 text-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8h4V24h-4V8zm7 0h3.83v2.18h.06c.53-1 1.84-2.18 3.79-2.18 4.05 0 4.8 2.67 4.8 6.15V24h-4v-7.08c0-1.69-.03-3.86-2.35-3.86-2.36 0-2.72 1.84-2.72 3.74V24h-4V8z"/></svg>
              </span>
              <span>
                <span class="block font-semibold text-text-primary">LinkedIn</span>
                <span class="text-sm">Professional profile and updates</span>
              </span>
            </a>

            <a
              href="https://github.com/mabaan"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3 p-3 rounded-xl border border-muted hover:border-accent hover:text-accent transition no-underline"
            >
              <span class="mt-0.5 text-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .5C5.73.5.5 5.73.5 12.02c0 5.12 3.29 9.46 7.86 10.99.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.97-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.95.1-.74.4-1.25.73-1.54-2.56-.29-5.26-1.28-5.26-5.72 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.05 11.05 0 012.88-.39 11.05 11.05 0 012.88.39c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.84 1.18 3.1 0 4.45-2.7 5.42-5.27 5.71.41.35.77 1.05.77 2.12 0 1.53-.01 2.77-.01 3.15 0 .3.2.66.79.55A10.53 10.53 0 0023.5 12.02C23.5 5.73 18.27.5 12 .5z"/></svg>
              </span>
              <span>
                <span class="block font-semibold text-text-primary">GitHub</span>
                <span class="text-sm">Code, projects, and experiments</span>
              </span>
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-muted bg-surface p-6 shadow-sm">
          <h3 class="text-lg font-bold text-text-primary mb-4">Quick Info</h3>
          <div class="space-y-4">
            <div class="flex gap-3 items-start">
              <span class="mt-1 text-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
              </span>
              <div>
                <p class="font-semibold text-text-primary">Location</p>
                <p class="text-sm text-text-secondary">Dubai, UAE (GMT+4)</p>
              </div>
            </div>
            <div class="flex gap-3 items-start">
              <span class="mt-1 text-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z" /><path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z" /></svg>
              </span>
              <div>
                <p class="font-semibold text-text-primary">Open to</p>
                <p class="text-sm text-text-secondary">Work, Projects, Research</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border-2 border-accent/20 bg-gradient-to-br from-accent/5 to-transparent p-6 shadow-sm">
          <div class="flex items-start gap-3 mb-3">
            <svg class="w-6 h-6 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
            <div>
              <h3 class="text-lg font-bold text-text-primary">Preferred Contact</h3>
              <p class="text-sm text-text-secondary mt-1">For urgent matters, email is the fastest way to reach me. For professional inquiries, LinkedIn works great too.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-3">
        <ContactForm client:load />
      </div>
    </div>
  </section>
</MainLayout>
