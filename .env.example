# Use one of these token variable names:
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
# AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Contact

# Optional overrides if your Airtable field labels differ.
AIRTABLE_FIELD_FULL_NAME=Full Name
AIRTABLE_FIELD_EMAIL=Email
AIRTABLE_FIELD_COMPANY=Company
AIRTABLE_FIELD_REASON=Reason
AIRTABLE_FIELD_MESSAGE=Message

# Optional: comma-separated allowlist for browser origins posting to /api/contact
# Example: https://mabaan.com,https://www.mabaan.com,http://localhost:4321
CONTACT_ALLOWED_ORIGINS=
